# Only unavailable placeholders. No host directories, networks or images are assumed.
ALCOR_APP_IMAGE=ghcr.io/replace-owner/alcor-api:latest
# App configuration belongs in app.env. Watchtower is configured independently.
ALCOR_DEPLOYMENT_IMAGE=ghcr.io/replace-owner/alcor-api
ALCOR_EXISTING_NETWORK=REPLACE_WITH_VERIFIED_EXISTING_NETWORK
ALCOR_PRIVATE_STATE_DIR=/REPLACE/private-alcor-state
ALCOR_UPLOADS_DIR=/REPLACE/private-alcor-uploads
ALCOR_ASSETS_DIR=/REPLACE/private-alcor-assets
ALCOR_BACKUP_ARCHIVE_DIR=/REPLACE/encrypted-alcor-backups
ALCOR_BACKUP_RECOVERY_KEY_DIR=/REPLACE/independent-alcor-recovery-key
ALCOR_HOST_PORT=8088
ALCOR_PLATFORM=linux/amd64
