# Copy to app.env outside Git. Set values only after verifying the NAS target.
ALCOR_ENVIRONMENT=staging
ALCOR_PUBLIC_ORIGIN=https://alcor.example.invalid
ALCOR_INSTANCE_ID=00000000-0000-0000-0000-000000000000
ALCOR_DATABASE_URL=postgresql://alcor_app:REPLACE@postgres:5432/alcor_platform
ALCOR_REDIS_URL=redis://alcor_cache:REPLACE@redis:6379/0
ALCOR_POOL_SIZE=5
ALCOR_WORKER_POLL_SECONDS=1
ALCOR_LEASE_SECONDS=30
ALCOR_CONNECTION_SECRET_DIR=/var/lib/alcor/state/connection-secrets
ALCOR_FILE_ROOT=/var/lib/alcor/uploads
ALCOR_ASSET_ROOT=/var/lib/alcor/assets
ALCOR_BACKUP_DIR=/var/lib/alcor/backups
ALCOR_BACKUP_SECRET_DIR=/var/lib/alcor/backup-key
ALCOR_BACKUP_MAX_BYTES=67108864
ALCOR_RESTORE_TARGETS=[]
# Independent GitHub release discovery (repository-scoped token; never shown in the UI).
ALCOR_DEPLOYMENT_REPOSITORY=
ALCOR_DEPLOYMENT_IMAGE=
ALCOR_DEPLOYMENT_GITHUB_TOKEN=
# Match compose.env updater token; at least 32 random characters. No Docker socket in app.
ALCOR_DEPLOYMENT_RUNNER_TOKEN=
# Optional GitHub OAuth App. Callback: PUBLIC_ORIGIN/api/deployment/github/callback
ALCOR_DEPLOYMENT_GITHUB_CLIENT_ID=
ALCOR_DEPLOYMENT_GITHUB_CLIENT_SECRET=

# 自定义汇率的实例允许名单；默认不允许外部目标。实际地址只在本机配置填写。
# 目标格式示例：[{"target":["https","rates.example",443,"/latest"],"addresses":["192.0.2.20"]}]
ALCOR_FX_PROVIDER_TARGETS=[]
