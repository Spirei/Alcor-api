# 配套 deploy/compose.synology.yaml；复制为 compose.yaml 同目录的 .env。
# 根目录 .env.example 提供同内容副本；不要上传正式配置。
# 个人宿主机目录仅在本机配置；必须替换下面的占位值。
ALCOR_DATA_DIR=/REPLACE/alcor-data

# 首次运行 GitHub Actions 的 Publish AlcorApi 后使用 latest。
# 无需填写 Git 提交、digest 或软件版本；版本由镜像自身提供。
ALCOR_APP_IMAGE=ghcr.io/replace-owner/alcor-api:latest
# 必填：共同的自建 Docker 网络名称，不填 IP 或网关。
# 应用、PG、Redis 均须接入；默认 bridge 不自动解析容器名。
ALCOR_EXISTING_NETWORK=REPLACE_WITH_EXISTING_NETWORK

# 下面为应用连接配置；内部持久目录已在YAML中指定。
# 首次隔离验证用 staging；正式实例用 production，须与数据库登记一致。
# 环境标记不会自动隔离数据库。
ALCOR_ENVIRONMENT=staging
# 必填：用户访问的 HTTPS 地址，可含端口，不含路径或末尾斜杠。
ALCOR_PUBLIC_ORIGIN=https://alcor.example.invalid
# 仅填写实际反向代理直连 API 的 IP；保持空数组时不信任转发协议头。禁止通配符和网段。
# 代理必须覆盖转发头，不得透传客户端提供的伪造值。
ALCOR_TRUSTED_PROXY_IPS=[]
# 必填：首次初始化生成并登记的 UUID（可用 uuidgen 生成），替换全零值。
# 已有实例沿用原 UUID；更新不重新生成；填写此项不等于初始化数据库。
ALCOR_INSTANCE_ID=00000000-0000-0000-0000-000000000000
# 必填：独立 PostgreSQL 数据库和账号，不指向旧业务数据库。
# 格式：postgresql://用户名:密码@主机:端口/数据库名；不加 http://。
# HOST 为共享自建网络内的实际容器名/别名，5432 改为实际容器监听端口。
# 通过宿主机映射端口访问时，改填宿主机地址及实际映射端口。
# 用户名和密码中的特殊字符需要 URL 编码。
ALCOR_DATABASE_URL=postgresql://REPLACE_PG_USER:REPLACE_PG_PASSWORD@REPLACE_PG_HOST:5432/REPLACE_PG_DATABASE
# 必填：平台独立 Redis ACL 账号及允许的缓存范围，不复用旧应用凭据。
# HOST 和端口同样填写实际可达地址；特殊字符需要 URL 编码。
ALCOR_REDIS_URL=redis://REPLACE_REDIS_USER:REPLACE_REDIS_PASSWORD@REPLACE_REDIS_HOST:6379/0
# 以下连接池和 Worker 参数默认可保留。
ALCOR_POOL_SIZE=5
ALCOR_WORKER_POLL_SECONDS=1
ALCOR_LEASE_SECONDS=30
# 单次备份上限，单位字节；67108864 = 64 MiB。
ALCOR_BACKUP_MAX_BYTES=67108864
# 恢复目标白名单；默认不配置，实际恢复前另行核对隔离目标。
ALCOR_RESTORE_TARGETS=[]
# 网页发布与更新：仓库和镜像名同时填写，须与上面的应用镜像对应。
# 仓库格式 OWNER/REPOSITORY；镜像格式 ghcr.io/owner/repository（小写，无标签）。
ALCOR_DEPLOYMENT_REPOSITORY=replace-owner/alcor-api
ALCOR_DEPLOYMENT_IMAGE=ghcr.io/replace-owner/alcor-api
# 私有仓库发布信息的读取凭据，仅授权需要的仓库。
ALCOR_DEPLOYMENT_GITHUB_TOKEN=
# 可选：独立 Watchtower HTTP API 的令牌，至少32个随机字符；与其本机配置一致。
# Watchtower 单独部署，本项目不创建该容器，应用不挂载 Docker socket。
ALCOR_DEPLOYMENT_RUNNER_TOKEN=
ALCOR_DEPLOYMENT_UPDATER_URL=
# 可选：自己的 GitHub OAuth App；不用时留空。
# 回调地址为上述 PUBLIC_ORIGIN + /api/deployment/github/callback。
ALCOR_DEPLOYMENT_GITHUB_CLIENT_ID=
ALCOR_DEPLOYMENT_GITHUB_CLIENT_SECRET=

# 可选：身份邮件由独立 Worker 投递；默认关闭，启用前填写自己的 TLS SMTP 配置。
ALCOR_MAIL_ENABLED=false
ALCOR_MAIL_HOST=
ALCOR_MAIL_PORT=587
ALCOR_MAIL_TLS=starttls
ALCOR_MAIL_SENDER=
ALCOR_MAIL_USERNAME=
ALCOR_MAIL_PASSWORD=
ALCOR_MAIL_TIMEOUT=10

# 自定义汇率的实例允许名单；默认不允许外部目标。实际地址只在本机配置填写。
# 目标格式示例：[{"target":["https","rates.example",443,"/latest"],"addresses":["192.0.2.20"]}]
ALCOR_FX_PROVIDER_TARGETS=[]
